# --- Web dashboard (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (e.g. https://hourguard.hirejps.com). Used to point
# server-generated auth links (e.g. the Paddle set-password link) back here,
# since the Supabase project is shared across the portal products. Optional in
# dev; set it in production.
NEXT_PUBLIC_APP_URL=https://hourguard.hirejps.com

# Screenshot retention cleanup (Vercel Cron -> /api/cron/cleanup-screenshots).
# CRON_SECRET must match the value Vercel sends as "Authorization: Bearer <secret>".
# SCREENSHOT_RETENTION_DAYS defaults to 90 if unset.
CRON_SECRET=your-cron-secret
SCREENSHOT_RETENTION_DAYS=90

# Paddle purchase webhook (-> /api/webhooks/paddle). Auto-provisions an org +
# owner after purchase. Set to the "secret key" of the Paddle webhook
# destination. Pass { email, org_name } in the checkout's custom_data.
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

# --- Desktop tracker (apps/desktop) ---
# electron-vite only injects MAIN_VITE_-prefixed vars into the main process.
# These are baked into the build, so set them before running build:desktop / package.
MAIN_VITE_SUPABASE_URL=https://your-project.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=your-anon-key
