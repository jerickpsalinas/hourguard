# --- Web dashboard (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Screenshot retention cleanup (Vercel Cron -> /api/cron/cleanup-screenshots).
# CRON_SECRET must match the value Vercel sends as "Authorization: Bearer <secret>".
# SCREENSHOT_RETENTION_DAYS defaults to 90 if unset.
CRON_SECRET=your-cron-secret
SCREENSHOT_RETENTION_DAYS=90

# --- Desktop tracker (apps/desktop) ---
# electron-vite only injects MAIN_VITE_-prefixed vars into the main process.
# These are baked into the build, so set them before running build:desktop / package.
MAIN_VITE_SUPABASE_URL=https://your-project.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=your-anon-key
